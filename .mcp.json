{
  "mcpServers": {
    "meu-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tsx", "packages/mcp-server/src/index.ts"],
      "env": {
        "INTERNAL_API_URL": "http://localhost:5052",
        "INTERNAL_API_TOKEN": "${INTERNAL_API_TOKEN:-dev}"
      }
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"],
      "env": {}
    }
  }
}
